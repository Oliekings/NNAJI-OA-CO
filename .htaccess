<IfModule mod_rewrite.c>
    RewriteEngine On
    Options +FollowSymLinks

    # Security: Block direct access to sensitive files
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml) - [F,L,NC]

    # Security: Block sensitive internal directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests)/ - [F,L,NC]
    RewriteRule ^storage/(framework|logs|private)/ - [F,L,NC]

    # Route all requests to public/ directory transparently
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
